# Firebase settings for the app (optional).
# Without them the LMS runs in local mode: data and accounts stay in this browser.
# To connect Firebase: copy this file to env/frontend.env, fill the values from
# Firebase Console → Project settings → Your apps → Web app, then restart "npm run dev".
# Only these VITE_… values reach the browser — never put passwords in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
