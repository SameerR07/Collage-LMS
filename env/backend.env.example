# Email settings for all LMS emails (drive details, student codes, applications, attendance).
# Copy this file to env/backend.env and fill in the two lines below.
# env/backend.env is private: it is never committed and never sent to the browser.

# The email address that sends the drive emails
SMTP_USER=
# Its password. For Gmail this must be a 16-letter App Password:
# Google Account → Security → 2-Step Verification (turn on) → App passwords → create one for "Mail".
SMTP_PASS=

# Gmail defaults — change only for another provider (e.g. the college mail server).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE=true          (true for port 465, false for 587)

# Who gets "New student registered" alerts (comma-separated). Default: SMTP_USER
# PLACEMENT_CELL_EMAIL=placementcell@gjimt.ac.in

# Where students open the LMS — adds an "Open the student portal" button to student emails
# APP_URL=https://lms.gjimt.ac.in

# Name students see in their inbox, and an optional reply-to address
MAIL_FROM_NAME=GJIMT Placement Cell
# MAIL_REPLY_TO=placementcell@gjimt.ac.in

# Pause between emails in milliseconds (gentle on Gmail's limits)
MAIL_DELAY_MS=300

# "Continue with Google" on the student login — the OAuth Client ID from Google Cloud
# (ends with .apps.googleusercontent.com). See GOOGLE_SIGNIN_SETUP.md. No client secret is needed.
GOOGLE_CLIENT_ID=

# Only for hosting the stand-alone mail server (npm run mail-server):
# MAIL_SERVER_HOST=127.0.0.1
# MAIL_SERVER_PORT=8787
# MAIL_API_TOKEN=            (if set, the app must send the same value as VITE_MAIL_API_TOKEN)
